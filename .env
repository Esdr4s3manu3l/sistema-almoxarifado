# Defina o banco de dados que deseja usar.
# Deixe comentado (#) para usar o SQLite local automaticamente, 
# ou descomente e ajuste caso queira usar MySQL ou PostgreSQL.

# Opção 1: SQLite Padrão (Arquivo interno e permanente)
DATABASE_URL=sqlite:///./almoxarifado.db

# Opção 2: Exemplo de MySQL (Remova o '#' da linha abaixo para usar)
# DATABASE_URL=mysql+pymysql://esdras:Ed459201#@localhost:3306/almoxarifado

# Opção 3: Exemplo de PostgreSQL (Remova o '#' da linha abaixo para usar)
# DATABASE_URL=postgresql+psycopg2://esdras:Ed459201#@localhost:5432/almoxarifado